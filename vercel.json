{
    "functions": {
        "api/**/*.ts": {
            "runtime": "vercel-deno@latest"
        }
    },
    "builds": [
        {
            "src": "scripts/dev.js",
            "use": "vercel-deno@latest"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "scripts/dev.js"
        }
    ]
}